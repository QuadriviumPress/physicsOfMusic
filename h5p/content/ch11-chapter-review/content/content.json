      "metadata": {
        "title": "Compared with an open cylindrical pipe of the same length, what does a stopped cylindrical pipe do?",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>Compared with an open cylindrical pipe of the same length, what does a stopped cylindrical pipe do?</p>",
        "answers": [
          {
            "text": "<div>Sounds an octave lower and supports odd harmonics.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Sounds an octave higher and supports all harmonics.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Sounds at the same fundamental but lacks odd harmonics.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Has no standing-wave resonances.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
