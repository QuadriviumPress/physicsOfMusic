      "library": "H5P.MultiChoice 1.16",
      "subContentId": "7a2abb30-b068-42df-9a8a-dea28b5d4ad1",
      "metadata": {
        "title": "Where must an anti-aliasing low-pass filter act?",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>Where must an anti-aliasing low-pass filter act?</p>",
        "media": {
          "disableImageZooming": false
        },
        "answers": [
          {
            "text": "<div>Before sampling, while frequencies above Nyquist can still be removed.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>After sampling, once aliases are visible.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Only during playback.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Only before analog amplification.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
        ],
