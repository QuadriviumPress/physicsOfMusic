      "metadata": {
        "title": "Why does the singer’s formant near 2.9 kHz improve projection? Select all that apply.",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>Why does the singer’s formant near 2.9 kHz improve projection? Select all that apply.</p>",
        "media": {
          "disableImageZooming": false
        },
        "answers": [
          {
            "text": "<div>It falls in a relatively sparse region of the orchestra’s spectrum.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>The ear is highly sensitive in that frequency region.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Low-frequency orchestral sound masks upward more readily than the voice cluster masks downward.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>It moves every vocal harmonic down to the fundamental.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
        ],
