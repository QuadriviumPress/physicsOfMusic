      "subContentId": "4ba6ad50-1848-4391-9847-8f64b3331266",
      "metadata": {
        "title": "Which statements describe a periodic musical waveform? Select all that apply.",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>Which statements describe a periodic musical waveform? Select all that apply.</p>",
        "media": {
          "disableImageZooming": false
        },
        "answers": [
          {
            "text": "<div>Its sinusoidal components occur at whole-number multiples of the fundamental.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Its line spectrum has no energy between the harmonics.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Its harmonic phases uniquely determine its pitch.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>It must contain only odd harmonics.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
        ],
